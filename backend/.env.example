# Copy this file to .env and fill in real values

# PostgreSQL connection
DATABASE_URL=postgresql://menu_user:menu_password@localhost:5432/restaurant_menu

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First Level 1 (developer/owner) account, used only by seed.py
SEED_LEVEL1_EMAIL=owner@example.com
SEED_LEVEL1_PASSWORD=change-me-now
SEED_LEVEL1_NAME=System Owner

# Where uploaded food/brand images are stored on disk (served as static files)
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/static/uploads
